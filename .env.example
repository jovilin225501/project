# ====================================================================
# EcoTrack — Environment Configuration Template
# Copy this file to .env in the respective directories or server/.env
# NEVER commit your actual .env file or real credentials to Git!
# ====================================================================

# ----------------- Server Environment Variables -----------------
# Port for Express API server
PORT=5000

# MongoDB Atlas Connection String
# Replace <username>, <password>, and <cluster-url> with your MongoDB Atlas details:
# Example: mongodb+srv://myUser:myPassword@cluster0.abcde.mongodb.net/ecotrack?retryWrites=true&w=majority
MONGODB_URI=your_actual_mongodb_atlas_connection_string

# JWT Secret and Token Lifespan
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# Allowed Frontend Client URL (for CORS protection)
CLIENT_URL=http://localhost:5173

# Application Environment (development | production | test)
NODE_ENV=development

# Initial Administrator Credentials (used by createAdmin.js and seedData.js)
ADMIN_NAME=EcoTrack Administrator
ADMIN_EMAIL=admin@ecotrack.org
ADMIN_PASSWORD=AdminSecurePassword123!

# ----------------- Client Environment Variables -----------------
# Centralized API Base URL for Vite React Frontend
VITE_API_URL=http://localhost:5000/api
