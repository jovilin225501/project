# EcoTrack Backend Environment Variables
PORT=5000
MONGODB_URI=your_actual_mongodb_atlas_connection_string
JWT_SECRET=your_super_secret_jwt_key_min_32_characters
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Optional default administrator setup for seeding
ADMIN_NAME=EcoTrack Administrator
ADMIN_EMAIL=admin@ecotrack.org
ADMIN_PASSWORD=AdminPassword123!
